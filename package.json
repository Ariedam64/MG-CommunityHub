{
  "name": "mg-community-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check:chess": "esbuild scripts/checkChessRules.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkChessRules.cjs --log-level=error && node node_modules/.cache/checkChessRules.cjs",
    "check:marks": "esbuild scripts/checkChessMarks.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/checkChessMarks.cjs --log-level=error && node node_modules/.cache/checkChessMarks.cjs"
  },
  "devDependencies": {
    "@types/tampermonkey": "^5.0.4",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "emoji-picker-element": "^1.29.1"
  }
}
